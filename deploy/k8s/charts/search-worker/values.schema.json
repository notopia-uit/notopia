          "title": "hostnames",
          "type": "array"
        },
        "parentRefs": {
          "description": "Gateway parent references",
          "items": {
            "additionalProperties": true,
            "required": [],
            "type": "object"
          },
          "title": "parentRefs",
          "type": "array"
        }
      },
      "required": [],
      "title": "route",
      "type": "object"
    },
    "runtime": {
      "default": "node",
      "description": "Application runtime",
      "title": "runtime",
      "type": "string"
    },
    "serviceAccount": {
      "additionalProperties": false,
      "properties": {
        "annotations": {
          "additionalProperties": true,
          "description": "Service account annotations",
          "required": [],
          "title": "annotations",
          "type": "object"
        },
        "create": {
          "default": true,
          "description": "Create service account",
          "title": "create",
          "type": "boolean"
        },
        "name": {
          "default": "",
          "description": "Existing or created account name",
          "title": "name",
          "type": "string"
        }
      },
      "required": [],
      "title": "serviceAccount",
      "type": "object"
    },
    "tolerations": {
      "description": "Pod tolerations",
      "items": {
        "additionalProperties": true,
        "required": [],
        "type": "object"
      },
      "title": "tolerations",
      "type": "array"
    }
