  "required": [
    "podSecurityContext",
    "containerSecurityContext",
    "image",
    "serviceAccount",
    "resources",
    "redis",
    "route",
    "autoscaling",
    "podDisruptionBudget",
    "otel",
    "hooks",
    "istio"
  ],
  "type": "object"
}