      "additionalProperties": false,
      "properties": {
        "urlSecret": {
          "additionalProperties": false,
          "description": "Existing Redis URL secret for shared tombstones",
          "properties": {
            "key": {
              "default": "url",
              "title": "key",
              "type": "string"
            },
            "name": {
              "default": "",
              "title": "name",
              "type": "string"
            }
          },
          "required": [
            "name",
            "key"
          ],
          "title": "urlSecret"
        }
      },
      "required": [],
