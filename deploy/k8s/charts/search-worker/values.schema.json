        "resourceAttributes": {
          "additionalProperties": true,
          "description": "Additional resource attributes",
          "required": [],
          "title": "resourceAttributes",
          "type": "object"
        }
      },
      "required": [],
      "title": "otel",
      "type": "object"
    },
    "podAnnotations": {
      "additionalProperties": true,
      "description": "Additional pod annotations",
      "required": [],
      "title": "podAnnotations",
      "type": "object"
    },
    "podDisruptionBudget": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": false,
          "description": "Enable disruption budget",
          "title": "enabled",
          "type": "boolean"
        },
        "minAvailable": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "pattern": "^([0-9]|[1-9][0-9]|100)%$",
              "type": "string"
            }
          ],
          "default": "1",
          "description": "Minimum available replicas",
          "required": [],
          "title": "minAvailable"
        }
      },
      "required": [],
      "title": "podDisruptionBudget",
      "type": "object"
    },
    "podLabels": {
      "additionalProperties": true,
      "description": "Additional pod labels",
      "required": [],
      "title": "podLabels",
      "type": "object"
    },
    "podSecurityContext": {
      "additionalProperties": false,
      "properties": {
        "fsGroup": {
          "default": 1000,
          "description": "Group owning supported writable volumes",
          "minimum": 1,
          "title": "fsGroup",
          "type": "integer"
        },
        "runAsGroup": {
          "default": 1000,
          "description": "Numeric primary group ID",
          "minimum": 0,
          "title": "runAsGroup",
          "type": "integer"
        },
        "runAsNonRoot": {
          "default": "true",
          "description": "Require the container to run as a non-root user",
          "required": [],
          "title": "runAsNonRoot"
        },
        "runAsUser": {
          "default": 1000,
          "description": "Numeric user ID; image files must be readable and executable by this user",
          "minimum": 0,
          "title": "runAsUser",
          "type": "integer"
        }
      },
      "required": [],
      "title": "podSecurityContext",
      "type": "object"
    },
