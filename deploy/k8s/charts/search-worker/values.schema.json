    "resources": {
      "additionalProperties": false,
      "properties": {
        "limits": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              }
            ]
          },
          "description": "Container resource limits; memory must be an integer quantity (e.g. 256Mi or 2Gi), not fractional",
          "properties": {
            "cpu": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                }
              ],
              "required": []
            },
            "memory": {
              "anyOf": [
                {
                  "pattern": "^[0-9]+(Ki|Mi|Gi|Ti|K|M|G|T)?$",
                  "type": "string"
                },
                {
                  "minimum": 0,
                  "type": "integer"
                }
              ],
              "required": []
            }
          },
          "required": [],
          "title": "limits",
          "type": "object"
        },
        "requests": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              }
            ]
          },
          "description": "Container resource requests",
          "properties": {
            "cpu": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                }
              ],
              "required": []
            },
            "memory": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                }
              ],
              "required": []
            }
          },
          "required": [],
          "title": "requests",
          "type": "object"
        }
      },
      "required": [],
      "title": "resources",
      "type": "object"
    },
