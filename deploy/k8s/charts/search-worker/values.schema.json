      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": false,
          "description": "Create HTTPRoute",
          "title": "enabled",
          "type": "boolean"
        },
        "exposeHealth": {
          "default": true,
          "description": "Expose health endpoints",
          "title": "exposeHealth",
          "type": "boolean"
        },
        "hostnames": {
          "description": "Route hostnames",
          "items": {
            "type": "string"
