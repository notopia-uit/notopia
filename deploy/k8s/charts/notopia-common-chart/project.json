{
  "name": "notopia-common-chart",
  "targets": {
    "gen": {
      "dependsOn": ["gen:schema", "gen:readme"]
    },
    "gen:schema": {
      "inputs": ["chartSchema"],
      "outputs": ["{projectRoot}/values.schema.json"],
      "executor": "nx:run-commands",
      "options": {
        "command": "helm-schema -p -c deploy/k8s/charts/notopia-common-chart"
      }
    },
    "gen:readme": {
      "inputs": ["chartReadme"],
      "outputs": ["{projectRoot}/README.md"],
      "executor": "nx:run-commands",
      "options": {
        "command": "helm-docs -c deploy/k8s/charts/notopia-common-chart"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "mkdir -p tmp/chart-lock",
          "flock tmp/chart-lock/notopia-common-chart.lock helm dependency build --skip-refresh deploy/k8s/charts/notopia-common-chart/tests/fixture",
          "flock -s tmp/chart-lock/notopia-common-chart.lock helm lint --strict deploy/k8s/charts/notopia-common-chart",
          "flock -s tmp/chart-lock/notopia-common-chart.lock helm lint --strict deploy/k8s/charts/notopia-common-chart/tests/fixture",
          "flock -s tmp/chart-lock/notopia-common-chart.lock bash -o pipefail -c 'helm template fixture deploy/k8s/charts/notopia-common-chart/tests/fixture | kubeconform -strict'"
        ],
        "parallel": false
      },
      "inputs": ["chart"],
      "dependsOn": []
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "mkdir -p tmp/chart-lock",
          "flock tmp/chart-lock/notopia-common-chart.lock helm dependency build --skip-refresh deploy/k8s/charts/notopia-common-chart/tests/fixture",
          "flock -s tmp/chart-lock/notopia-common-chart.lock helm unittest deploy/k8s/charts/notopia-common-chart/tests/fixture",
          "flock -s tmp/chart-lock/notopia-common-chart.lock node --test deploy/k8s/charts/notopia-common-chart/tests/*.test.ts"
        ],
        "parallel": false
      },
      "inputs": ["chart"],
      "dependsOn": []
    }
  }
}
