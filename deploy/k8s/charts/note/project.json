{
  "name": "note-chart",
  "targets": {
    "gen": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "helm-schema -p -c deploy/k8s/charts/note",
          "helm-docs -c deploy/k8s/charts/note"
        ],
        "parallel": false
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node deploy/k8s/charts/chart-check.ts note lint"
      },
      "inputs": ["chartInputs"],
      "dependsOn": []
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node deploy/k8s/charts/chart-check.ts note test"
      },
      "inputs": ["chartInputs"],
      "dependsOn": []
    }
  }
}
