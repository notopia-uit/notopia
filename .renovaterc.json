{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>notopia-uit/renovate-config", ":automergeBranch", ":automergePatch"],
  "packageRules": [
    {
      "description": "Notopia Kubernetes image tags are owned by the release workflow",
      "matchFileNames": ["deploy/k8s/**"],
      "matchPackageNames": ["ghcr.io/notopia-uit/**"],
      "enabled": false
    },
    {
      "groupName": "Nx Monorepo Toolkit",
      "matchPackageNames": ["nx", "/^@nx//", "/^nx$/", "/^npm:nx$/"],
      "automerge": false,
      "description": "Group all Nx packages to prevent version mismatch and allow manual migration. Note that renovate still create PRs for minor/major updates, but they will not be automerged."
    },
    {
      "groupName": "Codegen",
      "matchPackageNames": [
        "@hey-api/openapi-ts",
        "github.com/oapi-codegen/runtime",
        "go:github.com/oapi-codegen/oapi-codegen/v2/cmd/oapi-codegen"
      ],
      "automerge": true,
      "matchUpdateTypes": ["patch", "minor"]
    },
    {
      "matchPackageNames": ["/^.*@typescript/native-preview$/"],
      "automerge": true,
      "versioning": "loose"
    },
    {
      "matchPackageNames": ["rustfs/rustfs"],
      "automerge": true,
      "versioning": "loose"
    },
    {
      "groupName": "blocknote",
      "matchPackageNames": ["/^@blocknote/"]
    },
    {
      "groupName": "npm @suites",
      "matchPackageNames": ["/^@suites/"]
    },
    {
      "groupName": "go",
      "matchPackageNames": ["/^golang$/"],
      "automerge": false
    },
    {
      "groupName": "github",
      "matchPackageNames": ["/^github\\.com\\/.*$/"],
      "automerge": false
    },
    {
      "groupName": "wire",
      "matchPackageNames": ["go:github.com/goforj/wire/cmd/wire", "github.com/goforj/wire"]
    }
  ],
  "docker-compose": {
    "managerFilePatterns": ["/^deploy\\/compose\\/.+\\/.+\\.ya?ml$/"]
  },
  "flux": {
    "enabled": true,
    "managerFilePatterns": ["/^deploy\\/k8s\\/clusters\\/.+\\.ya?ml$/"]
  },
  "helm-values": {
    "enabled": true,
    "managerFilePatterns": ["/^deploy\\/k8s\\/clusters\\/.+\\/values\\.ya?ml$/"]
  },
  "schedule": ["* 1-18 * * 3,0"],
  "toolSettings": {
    "nodeMaxMemory": 2048
  }
}
