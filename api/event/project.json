{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "api/event",
  "projectType": "application",
  "targets": {
    "bundle:yaml": {
      "executor": "nx:run-commands",
      "options": {
        "command": "redocly bundle event --config ../redocly.yaml -o ./event.bundled.yaml",
        "cwd": "{projectRoot}"
      },
      "outputs": ["{projectRoot}/event.bundled.yaml"],
      "inputs": ["openapiFiles"]
    },
    "bundle:json": {
      "executor": "nx:run-commands",
      "options": {
        "command": "redocly bundle event --config ../redocly.yaml -o ./event.bundled.json",
        "cwd": "{projectRoot}"
      },
      "outputs": ["{projectRoot}/event.bundled.json"],
      "inputs": ["openapiFiles"]
    },
    "build": {
      "dependsOn": ["bundle:yaml", "bundle:json"]
    },
    "watch-bundle:json": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm nx watch --projects=api/event -- pnpm nx bundle:json \\$NX_PROJECT_NAME",
        "forwardAllArgs": false,
        "cwd": "{projectRoot}"
      },
      "continuous": true
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "redocly lint event --config ../redocly.yaml",
        "cwd": "{projectRoot}"
      },
      "inputs": ["openapiFiles"]
    },
    "gen:go": {
      "inputs": ["{projectRoot}/oapi-codegen.yaml"],
      "outputs": ["{workspaceRoot}/pkg/api/gen/event.gen.go"],
      "executor": "nx:run-commands",
      "options": {
        "command": "oapi-codegen --config ./oapi-codegen.yaml ./event.bundled.yaml",
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["bundle:yaml"]
    },
    "gen": {
      "dependsOn": ["gen:go"]
    }
  }
}
