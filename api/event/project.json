{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "api/event",
  "projectType": "application",
  "tags": ["scope:api", "type:openapi"],
  "targets": {
    "bundle:json": {
      "executor": "nx:run-commands",
      "options": {
        "command": "redocly bundle event --config ../redocly.yaml -o ../bundled/event.json",
        "cwd": "{projectRoot}"
      },
      "outputs": ["{projectRoot}/../bundled/event.json"],
      "inputs": ["openapiFiles"]
    },
    "build": {
      "dependsOn": ["bundle:json"]
    },
    "watch-bundle:json": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm nx watch --projects=api/event -- pnpm nx bundle:json \\$NX_PROJECT_NAME",
        "forwardAllArgs": false,
        "cwd": "{projectRoot}"
      },
      "continuous": true
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "scalar document serve -w ./openapi.yaml --port 9083",
        "forwardAllArgs": false,
        "cwd": "{projectRoot}"
      },
      "continuous": true
    },
    "preview": {
      "executor": "nx:run-commands",
      "options": {
        "command": "scalar document serve ../bundled/event.json --port 9083",
        "cwd": "{projectRoot}"
      },
      "continuous": true,
      "dependsOn": ["bundle:json"]
    },
    "mock": {
      "executor": "nx:run-commands",
      "options": {
        "command": "scalar document mock -w ./openapi.yaml --port 8083",
        "cwd": "{projectRoot}"
      },
      "continuous": true
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "redocly lint event --config ../redocly.yaml",
        "cwd": "{projectRoot}"
      },
      "inputs": ["openapiFiles"]
    },
    "gen:go": {
      "inputs": ["{projectRoot}/oapi-codegen.yaml", "openapiFiles"],
      "outputs": ["{workspaceRoot}/pkg/api/event/event.gen.go"],
      "executor": "nx:run-commands",
      "options": {
        "command": "oapi-codegen --config ./oapi-codegen.yaml ../bundled/event.json",
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["bundle:json"]
    },
    "gen": {
      "dependsOn": ["gen:go"]
    }
  }
}
