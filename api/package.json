{
  "name": "api",
  "private": true,
  "exports": {
    "./common": "./bundled/common.json",
    "./document": "./bundled/document.json",
    "./note": "./bundled/note.json",
    "./openapi": "./bundled/openapi.json"
  },
  "scripts": {
    "openapi-generator-cli": "openapi-generator-cli",
    "openapi-ts": "openapi-ts",
    "redocly": "redocly",
    "redocly:join": "redocly join ./openapi.yaml ./bundled/common.json ./bundled/document.json ./bundled/note.json -o ./bundled/openapi.json",
    "scalar": "scalar"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.92.3",
    "@openapitools/openapi-generator-cli": "^2.28.2",
    "@redocly/cli": "^2.14.5",
    "@scalar/cli": "^1.4.2"
  }
}
