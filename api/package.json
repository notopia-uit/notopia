{
  "name": "@notopia-uit/api",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./share": "./bundled/share.json",
    "./document": "./bundled/document.json",
    "./note": "./bundled/note.json",
    "./openapi": "./bundled/openapi.json"
  },
  "scripts": {
    "openapi-generator-cli": "openapi-generator-cli",
    "openapi-ts": "openapi-ts",
    "redocly": "redocly",
    "redocly:join": "redocly join ./openapi.yaml ./bundled/share.json ./bundled/document.json ./bundled/note.json --prefix-components-with-info-prop x-apiName -o ./bundled/openapi.json",
    "scalar": "scalar"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.94.5",
    "@openapitools/openapi-generator-cli": "2.30.2",
    "@redocly/cli": "2.22.1",
    "@scalar/cli": "1.7.6"
  }
}
