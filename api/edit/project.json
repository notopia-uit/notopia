{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "api/edit",
  "projectType": "application",
  "tags": ["scope:api", "type:openapi"],
  "targets": {
    "bundle:json": {
      "executor": "nx:run-commands",
      "options": {
        "command": "redocly bundle edit --config ../redocly.yaml -o ../bundled/edit.json",
        "cwd": "{projectRoot}"
      },
      "outputs": ["{projectRoot}/../bundled/edit.json"],
      "inputs": ["openapiFilesWithCommon"]
    },
    "build": {
      "dependsOn": ["bundle:json"]
    },
    "watch-bundle:json": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm nx watch --projects=api/edit -- pnpm nx bundle:json \\$NX_PROJECT_NAME",
        "forwardAllArgs": false,
        "cwd": "{projectRoot}"
      },
      "continuous": true
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "scalar document serve -w ./openapi.yaml --port 9082",
        "forwardAllArgs": false,
        "cwd": "{projectRoot}"
      },
      "continuous": true
    },
    "preview": {
      "executor": "nx:run-commands",
      "options": {
        "command": "scalar document serve ../../bundled/edit.json --port 9082",
        "cwd": "{projectRoot}"
      },
      "continuous": true,
      "dependsOn": ["bundle:json"]
    },
    "mock": {
      "executor": "nx:run-commands",
      "options": {
        "command": "scalar document mock -w ./openapi.yaml --port 8082",
        "cwd": "{projectRoot}"
      },
      "continuous": true
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "redocly lint edit --config ../redocly.yaml",
        "cwd": "{projectRoot}"
      },
      "inputs": ["openapiFilesWithCommon"]
    },
    "gen": {
      "dependsOn": ["gen:ts"]
    }
  },
  "implicitDependencies": ["api/common"]
}
