{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "api/edit",
  "projectType": "application",
  "targets": {
    "bundle:yaml": {
      "executor": "nx:run-commands",
      "options": {
        "command": "redocly bundle edit --config ../redocly.yaml -o ./dist/openapi.yaml",
        "cwd": "{projectRoot}"
      },
      "outputs": ["{projectRoot}/dist/openapi.yaml"],
      "inputs": ["openapiFiles"]
    },
    "bundle:json": {
      "executor": "nx:run-commands",
      "options": {
        "command": "redocly bundle edit --config ../redocly.yaml -o ./dist/openapi.json",
        "cwd": "{projectRoot}"
      },
      "outputs": ["{projectRoot}/dist/openapi.json"],
      "inputs": ["openapiFiles"]
    },
    "build": {
      "dependsOn": ["bundle:yaml", "bundle:json"]
    },
    "watch-bundle:json": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm nx watch --projects=api/edit -- pnpm nx bundle:json \\$NX_PROJECT_NAME",
        "forwardAllArgs": false,
        "cwd": "{projectRoot}"
      },
      "continuous": true
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "scalar document serve -w ./dist/openapi.json --port 9082",
        "forwardAllArgs": false,
        "cwd": "{projectRoot}"
      },
      "continuous": true,
      "dependsOn": ["bundle:json", "watch-bundle:json"]
    },
    "preview": {
      "executor": "nx:run-commands",
      "options": {
        "command": "scalar document serve ./dist/openapi.json --port 9082",
        "cwd": "{projectRoot}"
      },
      "continuous": true,
      "dependsOn": ["bundle:json"]
    },
    "mock": {
      "executor": "nx:run-commands",
      "options": {
        "command": "scalar document mock -w ./dist/openapi.json --port 8082",
        "cwd": "{projectRoot}"
      },
      "continuous": true,
      "dependsOn": ["bundle:json"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "redocly lint edit --config ../redocly.yaml",
        "cwd": "{projectRoot}"
      },
      "inputs": ["openapiFiles"]
    },
    "gen:ts": {
      "outputs": ["{workspaceRoot}/packages/notopia-api/src/edit/"],
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec openapi-ts",
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["bundle:json"]
    },
    "gen": {
      "dependsOn": ["gen:ts"]
    }
  }
}
