{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "api/edit",
  "projectType": "application",
  "targets": {
    "bundle:yaml": {
      "executor": "nx:run-commands",
      "options": {
        "command": "redocly bundle edit --config ../redocly.yaml -o ./edit.bundled.yaml",
        "cwd": "{projectRoot}"
      },
      "outputs": ["{projectRoot}/edit.bundled.yaml"],
      "inputs": ["openapiFiles"]
    },
    "bundle:json": {
      "executor": "nx:run-commands",
      "options": {
        "command": "redocly bundle edit --config ../redocly.yaml -o ./edit.bundled.json",
        "cwd": "{projectRoot}"
      },
      "outputs": ["{projectRoot}/edit.bundled.json"],
      "inputs": ["openapiFiles"]
    },
    "build": {
      "dependsOn": ["bundle:yaml", "bundle:json"]
    },
    "watch-bundle:json": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm nx watch --projects=api/edit -- pnpm nx bundle:json \\$NX_PROJECT_NAME",
        "forwardAllArgs": false,
        "cwd": "{projectRoot}"
      },
      "continuous": true
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "scalar document serve -w ./edit.bundled.json --port 9082",
        "forwardAllArgs": false,
        "cwd": "{projectRoot}"
      },
      "continuous": true,
      "dependsOn": ["bundle:json", "watch-bundle:json"]
    },
    "preview": {
      "executor": "nx:run-commands",
      "options": {
        "command": "scalar document serve ./edit.bundled.json --port 9082",
        "cwd": "{projectRoot}"
      },
      "continuous": true,
      "dependsOn": ["bundle:json"]
    },
    "mock": {
      "executor": "nx:run-commands",
      "options": {
        "command": "scalar document mock -w ./edit.bundled.json --port 8082",
        "cwd": "{projectRoot}"
      },
      "continuous": true,
      "dependsOn": ["bundle:json"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "redocly lint edit --config ../redocly.yaml",
        "cwd": "{projectRoot}"
      },
      "inputs": ["openapiFiles"]
    },
    "gen": {
      "dependsOn": ["gen:ts"]
    }
  }
}
