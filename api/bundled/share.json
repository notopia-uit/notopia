{
  "openapi": "3.0.4",
  "info": {
    "version": "0.0.0",
    "title": "Notopia API",
    "license": {
      "name": "MIT",
      "url": "https://github.com/notopia-uit/notopia/blob/main/LICENSE"
    },
    "x-apiName": "share"
  },
  "paths": {},
  "components": {
    "schemas": {
      "NoteSearch": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "46f94d4d-41b5-4df6-bf8d-270fb9a49c97"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "example": "Meeting Notes"
          },
          "plainTextContent": {
            "type": "string",
            "description": "Plain text content",
            "example": "This is the content of the note"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [
              "tag1",
              "tag2"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "plainTextContent"
        ]
      },
      "DocumentCommittedEvent": {
        "$ref": "#/components/schemas/EventBase"
      },
      "NoteUpdatedEvent": {
        "$ref": "#/components/schemas/EventBase"
      },
      "UserDeletedEvent": {
        "$ref": "#/components/schemas/EventBase"
      },
      "EventBase": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "3deadc5b-bde7-4b64-9c3b-1bc534378f36"
          },
          "metadata": {
            "type": "object",
            "properties": {
              "timestamp": {
                "type": "string",
                "format": "date-time",
                "example": "2024-01-01T12:00:00Z"
              },
              "correlationId": {
                "type": "string",
                "example": "ec601c67-209c-4e28-977b-30ea3e24a963"
              }
            },
            "required": [
              "timestamp"
            ]
          },
          "data": {
            "type": "object"
          }
        },
        "required": [
          "id",
          "metadata",
          "data"
        ]
      }
    }
  }
}