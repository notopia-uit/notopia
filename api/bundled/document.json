{
  "openapi": "3.0.4",
  "info": {
    "description": "Notopia API - A comprehensive note-taking service API.\n",
    "version": "0.0.0",
    "title": "Notopia API",
    "license": {
      "name": "MIT",
      "url": "https://github.com/notopia-uit/notopia/blob/main/LICENSE"
    },
    "contact": {
      "name": "Notopia Support",
      "email": "kevinnitro@duck.com"
    },
    "x-apiName": "document"
  },
  "servers": [
    {
      "url": "http://api.notopia.localhost"
    }
  ],
  "tags": [
    {
      "name": "Document",
      "description": "Operations related to documenting notes, collaboration."
    }
  ],
  "externalDocs": {
    "url": "https://notopia-uit.github.io/notopia"
  },
  "paths": {
    "/document/documents/import": {
      "post": {
        "security": [
          {
            "Oauth2": []
          }
        ],
        "tags": [
          "Document"
        ],
        "summary": "Import documents",
        "operationId": "importDocuments",
        "requestBody": {
          "$ref": "#/components/requestBodies/ImportDocumentsRequest"
        },
        "responses": {
          "201": {
            "$ref": "#/components/responses/ImportDocumentsResponse"
          },
          "400": {
            "$ref": "#/components/responses/BadRequestError"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/document/ws/documents/{documentId}": {
      "get": {
        "security": [
          {
            "Oauth2": []
          }
        ],
        "tags": [
          "Document"
        ],
        "summary": "WebSocket hocuspocus",
        "operationId": "wsDocument",
        "parameters": [
          {
            "$ref": "#/components/parameters/documentIdPath"
          }
        ],
        "responses": {
          "101": {
            "description": "Switching Protocols - WebSocket connection established"
          },
          "200": {
            "description": "OK"
          },
          "400": {
            "$ref": "#/components/responses/BadRequestError"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/document/documents/{documentId}/attachment-url": {
      "get": {
        "security": [
          {
            "Oauth2": []
          }
        ],
        "tags": [
          "Document"
        ],
        "summary": "Get document attachment upload url",
        "description": "Get presigned URL for document attachment upload",
        "operationId": "getDocumentAttachmentUploadUrl",
        "parameters": [
          {
            "$ref": "#/components/parameters/documentIdPath"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/GetDocumentAttachmentUploadUrlResponse"
          },
          "400": {
            "$ref": "#/components/responses/BadRequestError"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "Oauth2": {
        "type": "oauth2",
        "description": "OAuth2 Security Scheme",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "http://authentik.notopia.localhost/application/o/authorize",
            "tokenUrl": "http://authentik.notopia.localhost/application/o/token",
            "scopes": {
              "openid": "Required for OIDC",
              "profile": "Access to user profile"
            },
            "x-defaultClientId": "api-web",
            "x-scalar-client-id": "api-web",
            "x-usePkce": "SHA-256",
            "x-scalar-credentials-location": "header"
          }
        }
      }
    },
    "requestBodies": {
      "ImportDocumentsRequest": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "responses": {
      "ImportDocumentsResponse": {
        "description": "Successfully imported documents"
      },
      "BadRequestError": {
        "description": "Bad Request Error response",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "code": "BAD_REQUEST",
              "message": "The request could not be understood by the server due to malformed syntax",
              "more_info": "https://api.notopia.com/docs/errors/BAD_REQUEST"
            }
          }
        }
      },
      "UnauthorizedError": {
        "description": "Unauthorized Error response",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "code": "UNAUTHORIZED",
              "message": "Authentication is required to access this resource",
              "more_info": "https://api.notopia.com/docs/errors/UNAUTHORIZED"
            }
          }
        }
      },
      "NotFoundError": {
        "description": "Not Found Error response",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "code": "NOT_FOUND",
              "message": "The requested resource was not found",
              "more_info": "https://api.notopia.com/docs/errors/NOT_FOUND"
            }
          }
        }
      },
      "InternalServerError": {
        "description": "Internal Server Error response",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "code": "INTERNAL_SERVER_ERROR",
              "message": "An internal server error occurred. Please try again later",
              "more_info": "https://api.notopia.com/docs/errors/INTERNAL_SERVER_ERROR"
            }
          }
        }
      },
      "GetDocumentAttachmentUploadUrlResponse": {
        "description": "Presigned URL",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri",
                  "example": "http://rustfs.notopia.localhost/attachments/d4c6b66a-03a8-486d-a139-ab72635c009b"
                }
              },
              "required": [
                "url"
              ]
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Error code",
            "example": "EXAMPLE_CODE"
          },
          "message": {
            "type": "string",
            "description": "Human-readable error message",
            "example": "Example error"
          },
          "more_info": {
            "type": "string",
            "description": "URL with more information about the error",
            "example": "https://api.notopia.com/docs/errors/EXAMPLE_CODE"
          }
        },
        "required": [
          "code",
          "message"
        ]
      }
    },
    "parameters": {
      "documentIdPath": {
        "name": "documentId",
        "in": "path",
        "required": true,
        "description": "Unique identifier of the document (note)",
        "schema": {
          "type": "string",
          "format": "uuid"
        },
        "example": "46f94d4d-41b5-4df6-bf8d-270fb9a49c97"
      }
    }
  }
}