{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "api/share",
  "projectType": "application",
  "tags": ["scope:api", "type:openapi"],
  "targets": {
    "bundle:json": {
      "executor": "nx:run-commands",
      "options": {
        "command": "redocly bundle share --config ../redocly.yaml",
        "cwd": "{projectRoot}"
      },
      "outputs": ["{projectRoot}/../bundled/share.json"],
      "inputs": ["openapiFilesWithCommon"]
    },
    "build": {
      "dependsOn": ["bundle:json"]
    },
    "watch-bundle:json": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm nx watch --projects=api/share -- pnpm nx bundle:json \\$NX_PROJECT_NAME",
        "forwardAllArgs": false,
        "cwd": "{projectRoot}"
      },
      "continuous": true
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "scalar document serve -w ../bundled/share.json --port 9089",
        "forwardAllArgs": false,
        "cwd": "{projectRoot}"
      },
      "continuous": true,
      "dependsOn": ["watch-bundle:json", "bundle:json"]
    },
    "preview": {
      "executor": "nx:run-commands",
      "options": {
        "command": "scalar document serve ../bundled/share.json --port 9089",
        "cwd": "{projectRoot}"
      },
      "continuous": true,
      "dependsOn": ["bundle:json"]
    },
    "mock": {
      "executor": "nx:run-commands",
      "options": {
        "command": "scalar document mock -w ../bundled/share.json --port 8089",
        "cwd": "{projectRoot}"
      },
      "continuous": true,
      "dependsOn": ["bundle:json"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "redocly lint share --config ../redocly.yaml",
        "cwd": "{projectRoot}"
      },
      "inputs": ["openapiFilesWithCommon"]
    },
    "gen:go": {
      "inputs": ["{projectRoot}/oapi-codegen.yaml", "openapiFiles"],
      "outputs": ["{workspaceRoot}/pkg/api/share/share.gen.go"],
      "executor": "nx:run-commands",
      "options": {
        "command": "oapi-codegen --config ./oapi-codegen.yaml ../bundled/share.json",
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["bundle:json"]
    },
    "gen": {
      "dependsOn": ["gen:go"]
    }
  }
}
