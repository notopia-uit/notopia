{
  "$schema": "node_modules/@openapitools/openapi-generator-cli/config.schema.json",
  "spaces": 2,
  "generator-cli": {
    "version": "7.19.0",
    "generators": {
      "edit-nestjs-server": {
        "generatorName": "typescript-nestjs-server",
        "output": "#{cwd}/../packages/notopia-api-edit-nestjs-server",
        "glob": "./edit/edit.bundled.json",
        "additionalProperties": {
          "stringEnums": "true"
        }
      }
    }
  }
}
