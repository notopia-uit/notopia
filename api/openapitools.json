{
  "$schema": "node_modules/@openapitools/openapi-generator-cli/config.schema.json",
  "spaces": 2,
  "generator-cli": {
    "version": "7.21.0",
    "generators": {
      "document-nestjs-server": {
        "generatorName": "typescript-nestjs-server",
        "output": "#{cwd}/../packages/api-document-nestjs-server",
        "glob": "./bundled/document.json",
        "additionalProperties": {
          "stringEnums": "true"
        }
      }
    }
  }
}
