{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "api/note",
  "projectType": "application",
  "tags": ["scope:api", "type:openapi"],
  "targets": {
    "bundle:json": {
      "executor": "nx:run-commands",
      "options": {
        "command": "redocly bundle note --config ../redocly.yaml -o ../bundled/note.json",
        "cwd": "{projectRoot}"
      },
      "outputs": ["{projectRoot}/../bundled/note.json"],
      "inputs": ["openapiFilesWithCommon"]
    },
    "build": {
      "dependsOn": ["bundle:json"]
    },
    "watch-bundle:json": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm nx watch --projects=api/note -- pnpm nx bundle:json \\$NX_PROJECT_NAME",
        "forwardAllArgs": false,
        "cwd": "{projectRoot}"
      },
      "continuous": true
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "scalar document serve -w ./openapi.yaml --port 9081",
        "forwardAllArgs": false,
        "cwd": "{projectRoot}"
      },
      "continuous": true
    },
    "preview": {
      "executor": "nx:run-commands",
      "options": {
        "command": "scalar document serve ../bundled/note.json --port 9081",
        "cwd": "{projectRoot}"
      },
      "continuous": true,
      "dependsOn": ["bundle:json"]
    },
    "mock": {
      "executor": "nx:run-commands",
      "options": {
        "command": "scalar document mock -w ./openapi.yaml --port 8081",
        "cwd": "{projectRoot}"
      },
      "continuous": true
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "redocly lint note --config ../redocly.yaml",
        "cwd": "{projectRoot}"
      },
      "inputs": ["openapiFilesWithCommon"]
    },
    "gen:go": {
      "inputs": ["{projectRoot}/oapi-codegen.yaml", "openapiFiles"],
      "outputs": ["{workspaceRoot}/pkg/api/note/note.gen.go"],
      "executor": "nx:run-commands",
      "options": {
        "command": "oapi-codegen --config ./oapi-codegen.yaml ../bundled/note.json",
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["bundle:json"]
    },
    "gen": {
      "dependsOn": ["gen:go"]
    }
  },
  "implicitDependencies": ["api/common"]
}
