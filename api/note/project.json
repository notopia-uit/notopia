{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "api/note",
  "projectType": "application",
  "tags": ["scope:api", "type:openapi"],
  "targets": {
    "bundle:json": {
      "executor": "nx:run-commands",
      "options": {
        "command": "redocly bundle note --component-renaming-conflicts-severity off --config ../redocly.yaml",
        "cwd": "{projectRoot}"
      },
      "outputs": ["{projectRoot}/../bundled/note.json"],
      "inputs": ["openapiFilesWithCommon"]
    },
    "build": {
      "dependsOn": ["bundle:json"]
    },
    "watch-bundle:json": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm nx watch --projects=api/note -- pnpm nx bundle:json \\$NX_PROJECT_NAME",
        "forwardAllArgs": false,
        "cwd": "{projectRoot}"
      },
      "continuous": true
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "scalar document serve -w ../bundled/note.json --port 9081",
        "forwardAllArgs": false,
        "cwd": "{projectRoot}"
      },
      "continuous": true,
      "dependsOn": ["watch-bundle:json", "bundle:json"]
    },
    "preview": {
      "executor": "nx:run-commands",
      "options": {
        "command": "scalar document serve ../bundled/note.json --port 9081",
        "cwd": "{projectRoot}"
      },
      "continuous": true,
      "dependsOn": ["bundle:json"]
    },
    "mock": {
      "executor": "nx:run-commands",
      "options": {
        "command": "scalar document mock ../bundled/note.json --port 8081",
        "cwd": "{projectRoot}"
      },
      "continuous": true,
      "dependsOn": ["bundle:json"]
    },
    "mock:watch": {
      "executor": "nx:run-commands",
      "options": {
        "command": "scalar document mock -w ../bundled/note.json --port 8081",
        "cwd": "{projectRoot}"
      },
      "continuous": true,
      "dependsOn": ["watch-bundle:json", "bundle:json"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "redocly lint note --config ../redocly.yaml",
        "cwd": "{projectRoot}"
      },
      "inputs": ["openapiFilesWithCommon"]
    },
    "gen:gomodel": {
      "inputs": ["{projectRoot}/oapi-codegen-model.yaml", "openapiFiles", "oapiCodegenVersion"],
      "outputs": ["{workspaceRoot}/pkg/api/note/notemodel.gen.go"],
      "executor": "nx:run-commands",
      "options": {
        "command": "oapi-codegen --config ./oapi-codegen-model.yaml ../bundled/note.json",
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["bundle:json"]
    },
    "gen:goserver": {
      "inputs": ["{projectRoot}/oapi-codegen-server.yaml", "openapiFiles", "oapiCodegenVersion"],
      "outputs": ["{workspaceRoot}/pkg/api/note/noteserver.gen.go"],
      "executor": "nx:run-commands",
      "options": {
        "command": "oapi-codegen --config ./oapi-codegen-server.yaml ../bundled/note.json",
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["bundle:json"]
    },
    "gen:go": {
      "dependsOn": ["gen:gomodel", "gen:goserver"]
    },
    "gen": {
      "dependsOn": ["gen:go"]
    }
  }
}
