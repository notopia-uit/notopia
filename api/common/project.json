{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "api/common",
  "projectType": "application",
  "tags": ["scope:api", "type:openapi"],
  "targets": {
    "bundle:json": {
      "executor": "nx:run-commands",
      "options": {
        "command": "redocly bundle common --config ../redocly.yaml -o ./common.bundled.json",
        "cwd": "{projectRoot}"
      },
      "outputs": ["{projectRoot}/common.bundled.json"],
      "inputs": ["openapiFiles"]
    }
  }
}
