{
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "name": "api",
  "projectType": "application",
  "targets": {
    "bundle:yaml": {
      "dependsOn": ["^bundle:yaml"]
    },
    "bundle:json": {
      "dependsOn": ["^bundle:json"]
    },
    "bundle": {
      "dependsOn": ["^bundle"]
    },
    "watch-bundle:json": {
      "dependsOn": ["^watch-bundle:json"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "mock": {
      "dependsOn": ["^mock"]
    },
    "gen:go": {
      "dependsOn": ["^gen:go"]
    },
    "gen:ts": {
      "outputs": ["{workspaceRoot}/packages/notopia-api/src/"],
      "inputs": [
        "{projectRoot}/edit/dist/openapi.json",
        "{projectRoot}/note/dist/openapi.json",
        "{projectRoot}/openapi-ts.config.ts",
        "{projectRoot}/redocly.yaml"
      ],
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec openapi-ts",
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["^bundle:json"]
    },
    "gen": {
      "dependsOn": ["gen:ts", "^gen*"]
    }
  },
  "implicitDependencies": ["api/note", "api/edit"]
}
