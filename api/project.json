{
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "name": "api",
  "projectType": "application",
  "tags": ["scope:api", "type:openapi"],
  "targets": {
    "bundle:json": {
      "dependsOn": ["^bundle:json"]
    },
    "bundle": {
      "inputs": [
        "{projectRoot}/bundled/*.json",
        "!{projectRoot}/bundled/openapi.json"
      ],
      "outputs": ["{projectRoot}/bundled/openapi.json"],
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run redocly:join",
        "cwd": "{projectRoot}"
      }
    },
    "watch-bundle:json": {
      "dependsOn": ["^watch-bundle:json"]
    },
    "lint": {
      "executor": "nx:noop",
      "dependsOn": ["^lint"]
    },
    "mock": {
      "dependsOn": ["^mock"]
    },
    "gen:go": {
      "dependsOn": ["^gen:go"]
    },
    "gen:hey-api": {
      "outputs": ["{workspaceRoot}/packages/notopia-api/src/"],
      "inputs": [
        "{projectRoot}/bundled/openapi.json",
        "{projectRoot}/openapi-ts.config.ts"
      ],
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec openapi-ts",
        "cwd": "{projectRoot}"
      },
      "dependsOn": [{ "target": "bundle:json", "projects": "api/*" }]
    },
    "gen:edit-nestjs-server": {
      "outputs": ["{workspaceRoot}/packages/notopia-api-edit-nestjs-server/"],
      "inputs": [
        "{projectRoot}/bundled/edit.json",
        "{projectRoot}/openapitools.json"
      ],
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec openapi-generator-cli generate --generator-key edit-nestjs-server",
        "cwd": "{projectRoot}"
      },
      "dependsOn": [
        {
          "projects": "api/edit",
          "target": "bundle:json"
        }
      ]
    },
    "gen": {
      "dependsOn": ["gen:hey-api", "gen:edit-nestjs-server", "^gen*"]
    }
  },
  "implicitDependencies": ["api/note", "api/edit", "api/common"]
}
