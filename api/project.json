{
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "name": "api",
  "projectType": "application",
  "tags": ["scope:api", "type:openapi"],
  "targets": {
    "bundle:json": {
      "dependsOn": ["^bundle:json"]
    },
    "join": {
      "inputs": [
        "{projectRoot}/bundled/event.json",
        "{projectRoot}/bundled/note.json",
        "{projectRoot}/bundled/document.json"
      ],
      "outputs": ["{projectRoot}/bundled/openapi.json"],
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run redocly:join",
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["^bundle:json"],
      "cache": true
    },
    "watch-join": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm nx watch --projects=api --includeDependentProjects -- pnpm nx run-many --target bundle:json --target join -p \\$NX_PROJECT_NAME",
        "forwardAllArgs": false,
        "cwd": "{projectRoot}"
      },
      "continuous": true
    },
    "bundle": {
      "dependsOn": ["join"]
    },
    "watch-bundle:json": {
      "dependsOn": ["^watch-bundle:json"]
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "scalar document serve -w ./bundled/openapi.json --port 9080",
        "forwardAllArgs": false,
        "cwd": "{projectRoot}"
      },
      "continuous": true,
      "dependsOn": ["join", "watch-join", "^bundle:json"]
    },
    "lint": {
      "executor": "nx:noop",
      "dependsOn": ["^lint"]
    },
    "mock": {
      "dependsOn": ["^mock"]
    },
    "gen:go": {
      "dependsOn": ["^gen:go"]
    },
    "gen:hey-api": {
      "outputs": ["{workspaceRoot}/packages/notopia-api/src/"],
      "inputs": [
        "{projectRoot}/bundled/openapi.json",
        "{projectRoot}/openapi-ts.config.ts"
      ],
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec openapi-ts",
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["bundle"]
    },
    "gen:document-nestjs-server": {
      "outputs": [
        "{workspaceRoot}/packages/notopia-api-document-nestjs-server/"
      ],
      "inputs": [
        "{projectRoot}/bundled/document.json",
        "{projectRoot}/openapitools.json"
      ],
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec openapi-generator-cli generate --generator-key document-nestjs-server",
        "cwd": "{projectRoot}"
      },
      "dependsOn": [
        {
          "projects": "api/document",
          "target": "bundle:json"
        }
      ]
    },
    "gen": {
      "dependsOn": ["gen:hey-api", "gen:document-nestjs-server", "^gen*"]
    }
  },
  "implicitDependencies": ["api/note", "api/document", "api/event"]
}
