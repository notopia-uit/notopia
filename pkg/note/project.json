{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "pkg/note",
  "projectType": "library",
  "targets": {
    "gen:sqlc": {
      "inputs": [
        "{projectRoot}/infra/persistence/pgsqlc/*.sql",
        "{projectRoot}/migration/",
        "{projectRoot}/sqlc.yaml"
      ],
      "outputs": ["{projectRoot}/infra/persistence/pgsqlc/*.go"],
      "executor": "nx:run-commands",
      "options": {
        "command": "sqlc generate",
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "parallelism": false
    }
  }
}
