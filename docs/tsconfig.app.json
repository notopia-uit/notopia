{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "outDir": "out-tsc/app"
  },
  "contentMappers": [
    {
      "package": "@vue/content-mapper",
      "extensions": [".vue"],
      "options": {}
    }
  ],
  "include": [
    ".vitepress/*.mts",
    ".vitepress/*.ts",
    ".vitepress/theme/*.ts",
    ".vitepress/**/*.vue",
    "src/**/*.data.ts",
    "src/**/*.paths.ts"
  ],
  "exclude": [".vitepress/**/*.spec.ts"]
}
