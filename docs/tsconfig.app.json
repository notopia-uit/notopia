{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "outDir": "out-tsc/app"
  },
  "contentMappers": [
    {
      "package": "@vue/content-mapper",
      "extensions": [".vue"],
      "options": {}
    }
  ],
  "include": [".vitepress/config.mts", ".vitepress/theme/*.ts", ".vitepress/**/*.vue"],
  "exclude": [".vitepress/**/*.spec.ts"]
}
