{
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "name": "docs",
  "projectType": "application",
  "tags": ["scope:docs"],
  "namedInputs": {
    "default": [
      "{projectRoot}/.vitepress/config.{mts,ts}",
      "{projectRoot}/.vitepress/theme/**/*.{vue,ts,mts}",
      "{projectRoot}/src/**/*.md",
      "{projectRoot}/public/**",
      "{projectRoot}/diagrams/**"
    ]
  },
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitepress dev",
        "cwd": "{projectRoot}",
        "tty": true
      },
      "continuous": true
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitepress build",
        "cwd": "{projectRoot}"
      },
      "configurations": {
        "production": {
          "env": {
            "DOCS_BASE": "/notopia"
          }
        }
      },
      "outputs": ["{projectRoot}/.vitepress/dist"]
    },
    "preview": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "vitepress preview",
        "cwd": "{projectRoot}"
      },
      "continuous": true
    },
    "lint": {
      "executor": "nx:noop"
    }
  }
}
