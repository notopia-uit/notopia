{
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "name": "docs",
  "projectType": "application",
  "tags": ["scope:docs"],
  "implicitDependencies": ["api", "api-web"],
  "namedInputs": {
    "default": [
      "{projectRoot}/.vitepress/*.{mts,ts}",
      "{projectRoot}/package.json",
      "{projectRoot}/vitest.config.mts",
      "{projectRoot}/tsconfig*.json",
      "{projectRoot}/.vitepress/theme/**/*.{vue,ts,mts}",
      "{projectRoot}/src/**/*.md",
      "{projectRoot}/src/**/*.paths.ts",
      "{workspaceRoot}/deploy/k8s/charts/authorization/README.md",
      "{workspaceRoot}/deploy/k8s/charts/billing/README.md",
      "{workspaceRoot}/deploy/k8s/charts/document/README.md",
      "{workspaceRoot}/deploy/k8s/charts/note/README.md",
      "{workspaceRoot}/deploy/k8s/charts/notopia-edge/README.md",
      "{workspaceRoot}/deploy/k8s/charts/search-worker/README.md",
      "{workspaceRoot}/deploy/k8s/charts/web/README.md",
      "{projectRoot}/src/public/**",
      "!{projectRoot}/src/public/diagrams/**"
    ]
  },
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "dependsOn": [{ "projects": ["api"], "target": "join" }],
      "options": {
        "command": "vitepress dev",
        "cwd": "{projectRoot}",
        "tty": true
      },
      "continuous": true
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitepress build",
        "cwd": "{projectRoot}"
      },
      "dependsOn": [
        { "projects": ["api"], "target": "join" },
        { "projects": ["api-web"], "target": "build" }
      ],
      "inputs": [
        "default",
        { "dependentTasksOutputFiles": "api/bundled/openapi.json" },
        { "dependentTasksOutputFiles": "apps/api-web/dist/**/*" },
        { "env": "DOCS_BASE" }
      ],
      "outputs": ["{projectRoot}/.vitepress/dist"]
    },
    "preview": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "vitepress preview",
        "cwd": "{projectRoot}"
      },
      "continuous": true
    },
    "lint": {
      "executor": "nx:noop"
    }
  }
}
