{
  "$schema": "https://opencode.ai/config.json",
  "lsp": {
    "eslint": {
      "disabled": true
    }
  },
  "mcp": {
    "nx-mcp": {
      "type": "local",
      "command": ["pnpm", "exec", "nx", "mcp"],
      "enabled": false
    },
    "shadcn": {
      "type": "local",
      "command": [
        "mise",
        "exec",
        "npm:shadcn@latest",
        "--",
        "shadcn",
        "mcp",
        "--cwd",
        "packages/ui"
      ],
      "enabled": false
    },
    "grafana": {
      "type": "local",
      "command": ["mcp-grafana"],
      "environment": {
        "GRAFANA_URL": "http://grafana.notopia.localhost",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN": "{env:GRAFANA_SERVICE_ACCOUNT_TOKEN}"
      },
      "enabled": false
    }
  }
}
