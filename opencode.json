{
  "$schema": "https://opencode.ai/config.json",
  "plugins": ["superpowers@git+https://github.com/obra/superpowers.git"],
  "mcp": {
    "servers": {
      "nx-mcp": {
        "type": "local",
        "command": ["pnpm", "exec", "nx", "mcp"],
        "disabled": true
      },
      "shadcn": {
        "type": "local",
        "command": [
          "mise",
          "exec",
          "npm:shadcn@latest",
          "--",
          "shadcn",
          "mcp",
          "--cwd",
          "packages/ui"
        ],
        "disabled": true
      },
      "grafana": {
        "type": "local",
        "command": ["mcp-grafana"],
        "environment": {
          "GRAFANA_URL": "http://grafana.notopia.localhost",
          "GRAFANA_SERVICE_ACCOUNT_TOKEN": "{env:GRAFANA_SERVICE_ACCOUNT_TOKEN}"
        },
        "disabled": true
      }
    }
  },
  "formatter": {
    "prettier": {
      "disabled": true
    },
    "oxfmt": {
      "command": ["pnpm", "exec", "oxfmt", "--write", "$FILE"],
      "extensions": [
        ".css",
        ".html",
        ".js",
        ".json",
        ".jsx",
        ".less",
        ".md",
        ".scss",
        ".ts",
        ".tsx",
        "yaml"
      ]
    },
    "gofumpt": {
      "command": ["gofumpt", "-w", "$FILE"],
      "extensions": [".go", ".mod"]
    },
    "gofmt": {
      "disabled": true
    }
  }
}
