{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "nx-mcp": {
      "type": "local",
      "command": ["pnpm", "exec", "nx", "mcp"],
      "enabled": false
    },
    "shadcn": {
      "type": "local",
      "command": [
        "mise",
        "exec",
        "npm:shadcn@latest",
        "--",
        "shadcn",
        "mcp",
        "--cwd",
        "packages/ui"
      ],
      "enabled": false
    }
  }
}
