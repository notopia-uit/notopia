{
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "name": "page",
  "projectType": "application",
  "tags": ["scope:docs"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "inputs": ["default", "^default", { "env": "DOCS_BASE" }],
      "options": {
        "commands": [
          "rm -rf dist/",
          "mkdir -p dist",
          "mkdir -p dist/api",
          "cp -a ../docs/.vitepress/dist/. dist/",
          "cp -a ../apps/api-web/dist/. dist/api/"
        ],
        "parallel": false,
        "cwd": "{projectRoot}"
      },
      "outputs": ["{projectRoot}/dist"],
      "dependsOn": ["^build"]
    },
    "preview": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["pnpm preview"],
        "cwd": "{projectRoot}"
      },
      "continuous": true,
      "dependsOn": ["build"]
    },
    "deployPage": {
      "executor": "nx-github-pages:deploy",
      "dependsOn": ["build"],
      "cache": false,
      "options": {
        "syncWithBaseBranch": true,
        "preview": {
          "url": "https://notopia-uit.github.io/notopia",
          "pathPrefix": "pr/{prNumber}",
          "comment": true
        }
      }
    },
    "cleanup-previews": {
      "executor": "nx-github-pages:cleanup-preview",
      "cache": false,
      "options": {
        "pathPrefix": "pr",
        "maxAgeDays": 7,
        "updatePrComments": true
      }
    }
  },
  "implicitDependencies": ["docs", "apps/api-web"]
}
