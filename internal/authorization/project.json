{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "internal/authorization",
  "projectType": "library",
  "tags": ["scope:library", "type:go"],
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*.go",
      "{projectRoot}/policy/*.conf",
      "{projectRoot}/policy/*.csv",
      "!{projectRoot}/_test.go"
    ]
  },
  "targets": {
    "gen:mockery": {
      "executor": "nx:run-commands",
      "inputs": ["default", "mockeryVersion"],
      "options": {
        "command": "mockery",
        "cwd": "{projectRoot}"
      }
    }
  },
  "implicitDependencies": ["pkg"]
}
