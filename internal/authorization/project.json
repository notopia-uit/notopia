{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "internal/authorization",
  "projectType": "library",
  "tags": ["scope:library", "type:go"],
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*.go",
      "{projectRoot}/model.conf",
      "!{projectRoot}/_test.go"
    ],
    "test": ["{projectRoot}/**/*_test.go", "{projectRoot}/**/*.csv"]
  },
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "inputs": ["default", "test"],
      "options": {
        "command": "go test -v -covermode=atomic ./...",
        "cwd": "{projectRoot}"
      }
    }
  },
  "implicitDependencies": ["pkg"]
}
