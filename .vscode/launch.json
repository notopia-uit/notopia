{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Note",
      "type": "go",
      "request": "launch",
      "mode": "exec",
      "port": 23451,
      "cwd": "${workspaceFolder}",
      "dlvFlags": ["--output=${workspaceFolder}/cmd/note/__debug_bin"],
      "program": "${workspaceFolder}/cmd/note/__debug_bin",
      "envFile": "${workspaceFolder}/cmd/note/.env",
      "preLaunchTask": "Build Note (Debug)"
    },
    {
      "name": "Attach Note",
      "type": "go",
      "debugAdapter": "dlv-dap",
      "request": "attach",
      "mode": "remote",
      "host": "127.0.0.1",
      "port": 23451
    },
    {
      "name": "Debug Authorization",
      "type": "go",
      "request": "launch",
      "mode": "exec",
      "port": 23459,
      "cwd": "${workspaceFolder}",
      "dlvFlags": ["--output=${workspaceFolder}/cmd/authorization/__debug_bin"],
      "program": "${workspaceFolder}/cmd/authorization/__debug_bin",
      "envFile": "${workspaceFolder}/cmd/authorization/.env",
      "preLaunchTask": "Build Authorization (Debug)"
    },
    {
      "name": "Attach Authorization",
      "type": "go",
      "debugAdapter": "dlv-dap",
      "request": "attach",
      "mode": "remote",
      "host": "127.0.0.1",
      "port": 23459
    },
    {
      "type": "pwa-node",
      "request": "launch",
      "name": "Debug Document",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["exec", "nx", "run", "document"],
      "skipFiles": ["<node_internals>/**", "${workspaceFolder}/apps/document/dist/**"],
      "sourceMapPathOverrides": {
        "webpack://@notopia-uit/document/./*": "${workspaceFolder}/apps/document/*",
        "webpack://@notopia-uit/document/../../packages/api-document-nestjs-server/*": "${workspaceFolder}/packages/api-document-nestjs-server/*"
      },
      "outFiles": ["${workspaceFolder}/apps/document/dist/**/*.(m|c|)js", "!**/node_modules/**"]
    },
    {
      "type": "pwa-node",
      "request": "attach",
      "name": "Attach Document",
      "address": "localhost",
      "port": 9222,
      "skipFiles": ["<node_internals>/**", "${workspaceFolder}/apps/document/dist/**"],
      "restart": true,
      "sourceMapPathOverrides": {
        "webpack://@notopia-uit/document/./*": "${workspaceFolder}/apps/document/*",
        "webpack://@notopia-uit/document/../../packages/api-document-nestjs-server/*": "${workspaceFolder}/packages/api-document-nestjs-server/*"
      },
      "outFiles": ["${workspaceFolder}/apps/document/dist/**/*.(m|c|)js", "!**/node_modules/**"]
    },
    {
      "type": "pwa-node",
      "request": "launch",
      "name": "Debug Search Worker",
      "runtimeExecutable": "pnpm exec nx",
      "runtimeArgs": ["run", "search-worker"],
      "skipFiles": ["<node_internals>/**", "${workspaceFolder}/apps/search-worker/dist/**"],
      "sourceMapPathOverrides": {
        "webpack://@notopia-uit/search-worker/./*": "${workspaceFolder}/apps/search-worker/*",
        "webpack://@notopia-uit/search-worker/../../*": "${workspaceFolder}//*"
      },
      "outFiles": [
        "${workspaceFolder}/apps/search-worker/dist/**/*.(m|c|)js",
        "!**/node_modules/**"
      ]
    },
    {
      "type": "pwa-node",
      "request": "attach",
      "name": "Attach Search Worker",
      "address": "localhost",
      "port": 9223,
      "skipFiles": ["<node_internals>/**", "${workspaceFolder}/apps/search-worker/dist/**"],
      "restart": true,
      "sourceMapPathOverrides": {
        "webpack://@notopia-uit/search-worker/./*": "${workspaceFolder}/apps/search-worker/*",
        "webpack://@notopia-uit/search-worker/../../*": "${workspaceFolder}//*"
      },
      "outFiles": [
        "${workspaceFolder}/apps/search-worker/dist/**/*.(m|c|)js",
        "!**/node_modules/**"
      ]
    },
    {
      "name": "Debug Web (Browser Launch)",
      "type": "chrome",
      "request": "launch",
      "url": "http://web.notopia.localhost",
      "webRoot": "${workspaceFolder}/apps/web",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      "pathMapping": {
        "/_next/*": "${workspaceFolder}/apps/web/.next/*",
        "/_next/static/*": "${workspaceFolder}/apps/web/.next/static/*"
      },
      "sourceMapPathOverrides": {
        "webpack://_N_E/*": "${workspaceFolder}/*",
        "webpack://_N_E/apps/web/*": "${workspaceFolder}/apps/web/*",
        "webpack://_N_E/packages/ui/*": "${workspaceFolder}/packages/ui/*",
        "webpack://_N_E/packages/lib/*": "${workspaceFolder}/packages/lib/*",
        "webpack://_N_E/packages/api-gen/*": "${workspaceFolder}/packages/api-gen/*",
        "/turbopack/[project]/*": "${workspaceFolder}/*"
      }
    },
    {
      "name": "Debug Web (Browser Attach)",
      "type": "chrome",
      "request": "attach",
      "port": 9300,
      "urlFilter": "http://web.notopia.localhost/*",
      "webRoot": "${workspaceFolder}/apps/web",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      "pathMapping": {
        "/_next/*": "${workspaceFolder}/apps/web/.next/*",
        "/_next/static/*": "${workspaceFolder}/apps/web/.next/static/*"
      },
      "sourceMapPathOverrides": {
        "webpack://_N_E/*": "${workspaceFolder}/*",
        "webpack://_N_E/apps/web/*": "${workspaceFolder}/apps/web/*",
        "webpack://_N_E/packages/ui/*": "${workspaceFolder}/packages/ui/*",
        "webpack://_N_E/packages/lib/*": "${workspaceFolder}/packages/lib/*",
        "webpack://_N_E/packages/api-gen/*": "${workspaceFolder}/packages/api-gen/*",
        "/turbopack/[project]/*": "${workspaceFolder}/*"
      }
    },
    {
      "name": "Debug Web (Full)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["exec", "nx", "run", "web:debug"],
      "skipFiles": ["<node_internals>/**"],
      "sourceMapPathOverrides": {
        "webpack://_N_E/*": "${workspaceFolder}/*",
        "../../../*": "${workspaceFolder}/*",
        "../../*": "${workspaceFolder}/*",
        "server/app/*": "${workspaceFolder}/apps/web/app/*",
        "server/chunks/ssr/[root-of-the-server]__*": "${workspaceFolder}/apps/web/*",
        "server/chunks/ssr/packages_ui_src_*": "${workspaceFolder}/packages/ui/src/*",
        "server/chunks/ssr/packages_lib_src_*": "${workspaceFolder}/packages/lib/src/*",
        "server/chunks/ssr/packages_api-gen_src_*": "${workspaceFolder}/packages/api-gen/src/*",
        "server/chunks/ssr/packages_*": "${workspaceFolder}/packages/*",
        "/turbopack/[project]/*": "${workspaceFolder}/*"
      },
      "outFiles": ["${workspaceFolder}/apps/web/.next/**/*.js", "!**/node_modules/**"]
    },
    {
      "name": "Attach Web (Full)",
      "type": "pwa-node",
      "request": "attach",
      "port": 9300,
      "skipFiles": ["<node_internals>/**"],
      "sourceMapPathOverrides": {
        "webpack://_N_E/*": "${workspaceFolder}/*",
        "../../../*": "${workspaceFolder}/*",
        "../../*": "${workspaceFolder}/*",
        "server/app/*": "${workspaceFolder}/apps/web/app/*",
        "server/chunks/ssr/[root-of-the-server]__*": "${workspaceFolder}/apps/web/*",
        "server/chunks/ssr/packages_ui_src_*": "${workspaceFolder}/packages/ui/src/*",
        "server/chunks/ssr/packages_lib_src_*": "${workspaceFolder}/packages/lib/src/*",
        "server/chunks/ssr/packages_api-gen_src_*": "${workspaceFolder}/packages/api-gen/src/*",
        "server/chunks/ssr/packages_*": "${workspaceFolder}/packages/*",
        "/turbopack/[project]/*": "${workspaceFolder}/*"
      },
      "outFiles": ["${workspaceFolder}/apps/web/.next/**/*.js", "!**/node_modules/**"]
    }
  ]
}
