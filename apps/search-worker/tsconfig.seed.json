{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["node"],
    "target": "esnext",
    "rootDir": "seed",
    "outDir": "out-tsc/seed",
    "paths": {
      "#/*": ["./src/*"]
    }
  },
  "include": ["seed/**/*", "../../packages/lib-server/src/block-note/types.d.ts"],
  "references": [
    {
      "path": "../../packages/lib-server/tsconfig.lib.json"
    },
    {
      "path": "../../packages/api-share-gen/tsconfig.lib.json"
    }
  ]
}
