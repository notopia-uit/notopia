NODE_ENV=development

OTEL_SERVICE_NAME="search-worker"

NOTOPIA_SEARCH_WORKER_LOG_LEVEL=debug
NOTOPIA_SEARCH_WORKER_HEALTH_CHECK_PORT=28083

NOTOPIA_SEARCH_WORKER_KAFKA_BROKERS=localhost:19092
NOTOPIA_SEARCH_WORKER_KAFKA_CLIENT_ID=search-worker
NOTOPIA_SEARCH_WORKER_KAFKA_GROUP_ID=search-worker

NOTOPIA_SEARCH_WORKER_MEILI_HOST=http://meilisearch.notopia.localhost
NOTOPIA_SEARCH_WORKER_MEILI_API_KEY=notopiauit

# Unset: in-memory tombstones (single instance). Set to share tombstones across instances.
# NOTOPIA_SEARCH_WORKER_REDIS_URL=redis://localhost:6379
NOTOPIA_SEARCH_WORKER_TOMBSTONE_TTL_SECONDS=86400
NOTOPIA_SEARCH_WORKER_TOMBSTONE_MAX=100000
