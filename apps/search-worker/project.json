{
  "name": "search-worker",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "targets": {
    "prune-lockfile": {
      "dependsOn": ["build"],
      "cache": true,
      "executor": "@nx/js:prune-lockfile",
      "options": {
        "buildTarget": "build"
      }
    },
    "copy-workspace-modules": {
      "dependsOn": ["build"],
      "cache": true,
      "executor": "@nx/js:copy-workspace-modules",
      "options": {
        "buildTarget": "build"
      }
    },
    "prune": {
      "dependsOn": ["prune-lockfile", "copy-workspace-modules"],
      "executor": "nx:noop"
    },
    "build": {
      "options": {
        "mode": "development",
        "args": ["--node-env=development"]
      },
      "configurations": {
        "development": {
          "mode": "development",
          "args": ["--node-env=development"]
        },
        "production": {
          "mode": "production",
          "args": ["--node-env=production"]
        }
      }
    },
    "run": {
      "continuous": true,
      "executor": "@nx/js:node",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "search-worker:build:development",
        "inspect": false,
        "port": 9223,
        "watch": false
      }
    },
    "debug": {
      "continuous": true,
      "executor": "@nx/js:node",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "search-worker:build:development",
        "inspect": "inspect-brk",
        "port": 9223,
        "watch": false
      }
    },
    "docker:build": {
      "dependsOn": ["prune", "build", "^build"]
    },
    "nx-release-publish": {
      "parallelism": false
    }
  },
  "release": {
    "docker": {
      "repositoryName": "notopia-uit/search-worker"
    }
  }
}
