{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "module": "esnext",
    "types": ["node"],
    "rootDir": "src",
    "paths": {
      "*": ["./src/*"]
    },
    "tsBuildInfoFile": "dist/tsconfig.app.tsbuildinfo",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "target": "esnext",
    "esModuleInterop": true
  },
  "include": ["src/**/*.ts", "src/global.d.ts"],
  "exclude": ["eslint.config.js", "eslint.config.cjs", "eslint.config.mjs"],
  "references": [
    {
      "path": "../../packages/ui/tsconfig.lib.json"
    },
    {
      "path": "../../packages/pb/tsconfig.lib.json"
    },
    {
      "path": "../../packages/lib/tsconfig.lib.json"
    },
    {
      "path": "../../packages/api-document-nestjs-server/tsconfig.lib.json"
    }
  ]
}
