{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["node"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "target": "es2024",
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.app.tsbuildinfo",
    "paths": {
      "#/*": ["./src/*"],
      "@database/*": ["./database/*"]
    }
  },
  "include": ["src/**/*", "../../packages/lib/src/server/types.d.ts"],
  "references": [
    {
      "path": "../../packages/pb/tsconfig.lib.json"
    },
    {
      "path": "../../packages/api-document-nestjs-server/tsconfig.lib.json"
    },
    {
      "path": "../../packages/api-gen/tsconfig.lib.json"
    },
    {
      "path": "../../packages/lib/tsconfig.lib.json"
    }
  ]
}
