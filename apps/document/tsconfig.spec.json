{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./out-tsc/vitest",
    "types": ["vitest/globals", "node", "@rspack/core/module"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "paths": {
      "#/*": ["./src/*"]
    }
  },
  "include": [
    "vitest.config.mts",
    "{src,database}/**/*.spec.{ts,tsx,d.ts}",
    "../../packages/lib/src/server/types.d.ts"
  ],
  "exclude": ["dist/**/*", "out-tsc/**/*"],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.database.json"
    }
  ]
}
