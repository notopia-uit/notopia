{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "outDir": "./out-tsc/database/",
    "types": ["node"],
    "paths": {
      "#/*": ["./src/*"]
    }
  },
  "files": [],
  "include": ["database/**/*.ts", "../../packages/lib/src/server/types.d.ts"],
  "exclude": ["**/*.spec.ts"],
  "references": [
    {
      "path": "./tsconfig.app.json"
    }
  ]
}
