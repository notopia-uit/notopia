{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "document",
  "projectType": "application",
  "targets": {
    "build": {
      "defaultConfiguration": "development",
      "configurations": {
        "development": {
          "args": ["--node-env=development"]
        },
        "production": {
          "args": ["--node-env=production"]
        }
      }
    },
    "prune-lockfile": {
      "dependsOn": ["build"],
      "cache": true,
      "executor": "@nx/js:prune-lockfile",
      "outputs": [
        "{projectRoot}/dist/package.json",
        "{projectRoot}/dist/pnpm-lock.yaml"
      ],
      "options": {
        "buildTarget": "build"
      }
    },
    "copy-workspace-modules": {
      "dependsOn": ["build"],
      "cache": true,
      "outputs": ["{projectRoot}/dist/workspace_modules"],
      "executor": "@nx/js:copy-workspace-modules",
      "options": {
        "buildTarget": "build"
      }
    },
    "prune": {
      "dependsOn": ["prune-lockfile", "copy-workspace-modules"],
      "executor": "nx:noop"
    },
    "dev": {
      "continuous": true,
      "executor": "@nx/js:node",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "document:build:development"
      },
      "configurations": {
        "development": {
          "buildTarget": "document:build:development"
        },
        "development-mon": {
          "buildTarget": "document:build:development"
        },
        "production": {
          "buildTarget": "document:build:production"
        }
      }
    },
    "nx-release-publish": {
      "parallelism": false
    }
  },
  "release": {
    "docker": {
      "repositoryName": "notopia-uit/document"
    }
  }
}
