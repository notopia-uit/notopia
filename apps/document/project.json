{
  "name": "document",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "targets": {
    "prune-lockfile": {
      "dependsOn": ["build"],
      "cache": true,
      "executor": "@nx/js:prune-lockfile",
      "options": {
        "buildTarget": "build"
      }
    },
    "copy-workspace-modules": {
      "dependsOn": ["build"],
      "cache": true,
      "executor": "@nx/js:copy-workspace-modules",
      "options": {
        "buildTarget": "build"
      }
    },
    "prune": {
      "dependsOn": ["prune-lockfile", "copy-workspace-modules"],
      "executor": "nx:noop"
    },
    "build": {
      "options": {
        "mode": "development",
        "args": ["--node-env=development"]
      },
      "configurations": {
        "development": {
          "mode": "development",
          "args": ["--node-env=development"]
        },
        "production": {
          "mode": "production",
          "args": ["--node-env=production"]
        },
        "doctor": {}
      }
    },
    "run": {
      "continuous": true,
      "executor": "@nx/js:node",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "document:build:development",
        "inspect": false,
        "watch": false
      },
      "configurations": {
        "development": {
          "watch": false
        }
      }
    },
    "debug": {
      "continuous": true,
      "executor": "@nx/js:node",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "document:build:development",
        "inspect": "inspect-brk",
        "port": 9222,
        "watch": true
      }
    },
    "test": {
      "outputs": ["{projectRoot}/coverage/**", "{projectRoot}/test-report.junit.xml"]
    },
    "docker:build": {
      "dependsOn": [
        // "prune", // It got nx error, so just... generatePackageJson in build production
        "build",
        "^build"
      ]
    },
    "upload-codecov": {
      "executor": "nx:run-commands",
      "options": {
        "command": "codecov --disable-telem upload-process --disable-search --file ./test-report.junit.xml --flag document",
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["test"]
    },
    "nx-release-publish": {
      "parallelism": false
    }
  },
  "release": {
    "docker": {
      "repositoryName": "notopia-uit/document"
    }
  }
}
