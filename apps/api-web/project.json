{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "api-web",
  "projectType": "application",
  "targets": {
    "lint": {
      "executor": "nx-oxlint:lint",
      "options": {
        "configFile": "apps/api-web/oxlint.config.mts"
      }
    },
    "dev": {
      "dependsOn": [
        {
          "projects": ["api/note", "api/document"],
          "target": "watch-bundle:json"
        }
      ]
    }
  }
}
