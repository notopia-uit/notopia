{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@notopia-uit/tsconfig/react.json",
  "compilerOptions": {
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
    "outDir": "dist",
    "rootDir": "src",
    "target": "es2024",
    "moduleResolution": "bundler",
    "paths": {
      ".*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
