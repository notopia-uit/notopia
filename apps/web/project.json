{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "web",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "syncGenerators": ["@nx/js:typescript-sync"],
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/tsconfig.base.json",
        {
          "externalDependencies": ["next", "typescript", "@typescript/native"]
        }
      ],
      "outputs": ["{projectRoot}/.next/types", "{projectRoot}/next-env.d.ts"],
      "options": {
        "cwd": "{projectRoot}",
        "parallel": false,
        "commands": [
          "next typegen",
          "tsc --project tsconfig.json --noEmit --declarationMap false --emitDeclarationOnly false"
        ]
      }
    },
    "nx-release-publish": {
      "parallelism": false
    },
    "dev": {
      "options": {
        "hostname": "0.0.0.0"
      }
    },
    "debug": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm -F @notopia-uit/web run next dev --hostname 0.0.0.0 --inspect=9300"
      }
    },
    "serve-static": {
      "options": {
        "hostname": "0.0.0.0"
      }
    },
    "start": {
      "options": {
        "hostname": "0.0.0.0"
      },
      "configurations": {
        "mon": {}
      }
    },
    "docker:build": {
      "dependsOn": ["prune", "build", "^build"]
    }
  },
  "release": {
    "docker": {
      "repositoryName": "notopia-uit/web"
    }
  }
}
