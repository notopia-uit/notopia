{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "web",
  "targets": {
    "prune-lockfile": {
      "dependsOn": ["build"],
      "cache": true,
      "executor": "@nx/js:prune-lockfile",
      "options": {
        "outputPath": "{projectRoot}/.next/"
      }
    },
    "copy-workspace-modules": {
      "dependsOn": ["build"],
      "cache": true,
      "executor": "@nx/js:copy-workspace-modules",
      "options": {
        "outputPath": "{projectRoot}/.next/"
      }
    },
    "prune": {
      "dependsOn": ["prune-lockfile", "copy-workspace-modules"],
      "executor": "nx:noop"
    },
    "nx-release-publish": {
      "parallelism": false
    },
    "dev": {
      "options": {
        "hostname": "0.0.0.0"
      }
    },
    "debug": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm -F @notopia-uit/web run next --hostname 0.0.0.0 --inspect=9300"
      }
    },
    "serve-static": {
      "options": {
        "hostname": "0.0.0.0"
      }
    },
    "start": {
      "options": {
        "hostname": "0.0.0.0"
      }
    }
  },
  "release": {
    "docker": {
      "repositoryName": "notopia-uit/web"
    }
  }
}
