{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "noEmit": true,
    "resolveJsonModule": true,
    "lib": ["dom", "dom.iterable", "ES2024"],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
    "paths": {
      "#/*": ["./app/*"],
      "@lib/*": ["./lib/*"],
      "@ui/*": ["../../packages/ui/src/*"],
      "@notopia-uit/ui/*": ["../../packages/ui/src/*"],
      "@notopia-uit/api-gen/*": ["../../packages/api-gen/src/*"],
      "@notopia-uit/lib/*": ["../../packages/lib/src/*"]
    }
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "app/**/*.js",
    "app/**/*.jsx",
    "next-env.d.ts",
    "index.d.ts",
    "global.d.ts",
    ".next/types/**/*.ts",
    "postcss.config.mjs",
    "../../packages/ui/src/global.d.ts",
    "proxy.ts",
    "lib/**/*.ts"
  ],
  "exclude": ["out-tsc", "dist", "node_modules", "app/**/*.spec.ts", "app/**/*.test.ts", ".next"],
  "references": [
    {
      "path": "../../packages/ui"
    },
    {
      "path": "../../packages/api-gen"
    }
  ]
}
