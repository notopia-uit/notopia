{
  "extends": "@notopia-uit/tsconfig/nextjs.json",
  "compilerOptions": {
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
    "paths": {
      ".*": ["./src/*"],
      "@notopia-uit/ui/*": ["../../packages/ui/src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.js",
    "src/**/*.jsx",
    "../../packages/ui/src/**/*.ts",
    "../../packages/ui/src/**/*.tsx",
    "next-env.d.ts",
    "index.d.ts"
  ],
  "exclude": [
    "out-tsc",
    "dist",
    "node_modules",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    ".next",
    "eslint.config.mjs"
  ],
  "references": [
    {
      "path": "../../packages/ui"
    }
  ]
}
