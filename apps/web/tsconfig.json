{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "noEmit": true,
    "resolveJsonModule": true,
    "lib": ["dom", "dom.iterable", "ES2024"],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
    "paths": {
      "#/*": ["./app/*"],
      "@ui/*": ["../../packages/ui/src/*"],
      "@notopia-uit/ui/*": ["../../packages/ui/src/*"],
      "@notopia-uit/api-gen/*": ["../../packages/api-gen/src/*"],
      "@notopia-uit/block-note/*": ["../../packages/block-note/src/*"]
    }
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "app/**/*.js",
    "app/**/*.jsx",
    "next-env.d.ts",
    "index.d.ts",
    "global.d.ts",
    ".next/types/**/*.ts",
    "eslint.config.mjs",
    "postcss.config.mjs",
    "../../packages/ui/src/global.d.ts"
  ],
  "exclude": [
    "out-tsc",
    "dist",
    "node_modules",
    "app/**/*.spec.ts",
    "app/**/*.test.ts",
    ".next"
  ],
  "references": [
    {
      "path": "../../packages/ui"
    }
  ]
}
