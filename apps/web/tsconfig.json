{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "noEmit": true,
    "resolveJsonModule": true,
    "lib": ["dom", "dom.iterable", "ES2024"],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
    "paths": {
      "@/*": ["./src/*"],
      "@notopia-uit/ui/*": ["../../packages/ui/src/*"],
      "@notopia-uit/api-gen/*": ["../../packages/api-gen/src/*"],
      "@notopia-uit/block-note/*": ["../../packages/block-note/src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.js",
    "src/**/*.jsx",
    "next-env.d.ts",
    "index.d.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "out-tsc",
    "dist",
    "node_modules",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    ".next",
    "eslint.config.mjs"
  ],
  "references": [
    {
      "path": "../../packages/ui"
    }
  ]
}
