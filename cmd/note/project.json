{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "note",
  "projectType": "application",
  "tags": ["scope:service", "type:go"],
  "namedInputs": {
    "default": [
      "goPkgFiles",
      "goFiles",
      "{workspaceRoot}/api/**/*.go",
      "{workspaceRoot}/internal/note/**/*.go"
    ],
    "sqlc": [
      "{workspaceRoot}/internal/note/infra/persistence/pgsqlc/*.sql",
      "{workspaceRoot}/internal/note/infra/persistence/pgmigration/*.{sql,go}",
      "{projectRoot}/sqlc.yaml"
    ]
  },
  "targets": {
    "gen:wire": {
      "executor": "nx:run-commands",
      "inputs": ["default"],
      "outputs": ["{projectRoot}/wire_gen.go"],
      "options": {
        "command": "wire",
        "cwd": "{projectRoot}"
      },
      "cache": false
    },
    "build": {
      "executor": "nx:run-commands",
      "inputs": ["default"],
      "options": {
        "command": "go build -o ./dist/note .",
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["gen:wire", "^gen*", "^build*"]
    },
    "preview": {
      "executor": "nx:run-commands",
      "inputs": ["default"],
      "options": {
        "command": "./dist/note",
        "cwd": "{projectRoot}",
        "tty": true
      },
      "continuous": true,
      "dependsOn": ["build"]
    },
    "run": {
      "executor": "nx:run-commands",
      "inputs": ["default"],
      "options": {
        "command": "go run -gcflags='all=-N -l' .",
        "cwd": "{projectRoot}",
        "tty": true
      },
      "dependsOn": ["gen:wire", "^gen*"],
      "continuous": true
    },
    "debug": {
      "executor": "nx:run-commands",
      "inputs": ["default"],
      "options": {
        "command": "dlv debug --headless --listen=127.0.0.1:23451 --accept-multiclient",
        "cwd": "{projectRoot}",
        "tty": true
      },
      "dependsOn": ["gen:wire", "^gen*"],
      "continuous": true
    },
    "serve": {
      "dependsOn": ["run"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "golangci-lint run .",
        "cwd": "{projectRoot}"
      },
      "cache": false,
      "parallelism": false
    },
    "tidy": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go mod tidy"
      }
    },
    "goose": {
      "executor": "nx:run-commands",
      "options": {
        "command": "goose",
        "cwd": "{projectRoot}"
      }
    },
    "migration:create": {
      "executor": "nx:run-commands",
      "options": {
        "command": "goose create",
        "cwd": "{projectRoot}"
      }
    },
    "migration:up": {
      "executor": "nx:run-commands",
      "options": {
        "command": "goose up",
        "cwd": "{projectRoot}"
      }
    },
    "migration:down": {
      "executor": "nx:run-commands",
      "options": {
        "command": "goose down",
        "cwd": "{projectRoot}"
      }
    },
    "migration:validate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "goose validate",
        "cwd": "{projectRoot}"
      }
    },
    "lint:migration": {
      "dependsOn": ["migration:validate"]
    },
    "gen:sqlc": {
      "inputs": ["sqlc"],
      "outputs": [
        "{workspaceRoot}/internal/note/infra/persistence/pgsqlc/*.go"
      ],
      "executor": "nx:run-commands",
      "options": {
        "command": "sqlc generate",
        "cwd": "{projectRoot}"
      },
      "cache": true
    },
    "nx-release-publish": {
      "parallelism": false
    }
  },
  "implicitDependencies": ["pkg"],
  "release": {
    "docker": {
      "repositoryName": "notopia-uit/note"
    }
  }
}
