{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "authorization",
  "projectType": "application",
  "tags": ["scope:service", "type:go"],
  "namedInputs": {
    "default": [
      "goPkgFiles",
      "goFiles",
      "{workspaceRoot}/api/**/*.go",
      "{workspaceRoot}/internal/authorization/**/*.go"
    ],
    "test": [
      "{projectRoot}/**/*_test.go",
      "{workspaceRoot}/internal/authorization/**/*_test.go",
      "{workspaceRoot}/internal/authorization/**/*.csv"
    ]
  },
  "targets": {
    "gen:mockery": {
      "dependsOn": ["^gen:mockery"]
    },
    "gen:wire": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/wire_gen.go"],
      "options": {
        "command": "wire",
        "cwd": "{projectRoot}"
      },
      "cache": false
    },
    "run": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go run ./cmd/authorization/",
        "cwd": "{workspaceRoot}",
        "tty": true
      },
      "dependsOn": ["build-deps"],
      "continuous": true
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go build -o ./cmd/authorization/authorization ./cmd/authorization/",
        "cwd": "{workspaceRoot}"
      },
      "configurations": {
        "debug": {
          "command": "go build -gcflags='all=-N -l' -o ./cmd/authorization/__debug_bin ./cmd/authorization/"
        },
        "development": {
          "command": "go build -o ./cmd/authorization/authorization ./cmd/authorization/"
        },
        "production": {
          "command": "go build -ldflags='-s -w' -o ./cmd/authorization/authorization ./cmd/authorization/"
        }
      },
      "dependsOn": ["gen", "^gen*", "^build*"]
    },
    "build-deps": {
      "executor": "nx:noop",
      "dependsOn": ["gen", "^gen*", "^build*"]
    },
    "preview": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./authorization",
        "cwd": "{projectRoot}",
        "tty": true
      },
      "continuous": true,
      "dependsOn": ["build"]
    },
    "debug": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dlv debug --headless --listen=127.0.0.1:23459 --accept-multiclient --output ./cmd/authorization/__debug_bin ./cmd/authorization/",
        "cwd": "{workspaceRoot}",
        "tty": true
      },
      "dependsOn": ["build-deps"],
      "continuous": true
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "golangci-lint run ./cmd/authorization/... ./internal/authorization/...",
        "cwd": "{workspaceRoot}"
      },
      "cache": false,
      "parallelism": false
    },
    "gen": {
      "dependsOn": ["gen:wire", "gen:mockery"]
    },
    "nx-release-publish": {
      "parallelism": false
    },
    "test": {
      "executor": "nx:run-commands",
      "inputs": ["default", "test"],
      "outputs": [
        "{projectRoot}/coverage.out",
        "{projectRoot}/gotestsum.json",
        "{projectRoot}/tests-ctrf.json"
      ],
      "options": {
        "command": "./test.sh",
        "cwd": "{projectRoot}"
      },
      "configurations": {
        "production": {
          "command": "./test.sh --production"
        }
      }
    },
    "upload-codecov": {
      "executor": "nx:run-commands",
      "options": {
        "command": "codecov --disable-telem upload-process --disable-search --file ./coverage.out --flag authorization"
      },
      "dependsOn": ["test"]
    }
  },
  "implicitDependencies": ["pkg", "internal/authorization"],
  "release": {
    "docker": {
      "repositoryName": "notopia-uit/authorization"
    }
  }
}
