{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "notefixturegen",
  "projectType": "application",
  "tags": ["type:go"],
  "namedInputs": {
    "default": [
      "goFiles",
      "{workspaceRoot}/api/**/*.go",
      "{workspaceRoot}/internal/notefixturegen/**/*.go"
    ]
  },
  "targets": {
    "run": {
      "executor": "nx:run-commands",
      "inputs": ["default"],
      "options": {
        "command": "go run ./cmd/notefixturegen/...",
        "cwd": "{workspaceRoot}",
        "tty": true
      },
      "continuous": false
    },
    "lint": {
      "executor": "nx:run-commands",
      "inputs": ["default", "goLint"],
      "options": {
        "command": "golangci-lint run ./cmd/notefixturegen/... ./internal/notefixturegen/...",
        "cwd": "{workspaceRoot}"
      },
      "parallelism": false
    }
  }
}
