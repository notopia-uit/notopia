{
  "compilerOptions": {
    // "paths": {
    //   "@notopia-uit/ui/*": ["./packages/ui/src/*"],
    //   "@notopia-uit/ui": ["./packages/ui/src/index.ts"],
    //   "@notopia-uit/lib/*": ["./packages/lib/src/*"],
    //   "@notopia-uit/lib": ["./packages/lib/src/index.ts"],
    //   "@notopia-uit/pb": ["./packages/pb/index.ts"],
    //   "@notopia-uit/api-gen/*": ["./packages/api-gen/src/*"],
    //   "@notopia-uit/api-gen": ["./packages/api-gen/src/index.ts"],
    //   "@notopia-uit/api-document-nestjs-server": [
    //     "./packages/api-document-nestjs-server/index.ts"
    //   ]
    // },
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["@nx/source"]
  }
}
