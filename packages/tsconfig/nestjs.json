{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "target": "es2024",
    "sourceMap": true,
    "declaration": true,
    "importHelpers": true
  },
  "include": ["src/**/*.ts"]
}
