{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "noEmit": false,
    "resolveJsonModule": true,
    "lib": ["dom", "dom.iterable", "ES2024"],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
    "paths": {
      "./*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts"]
}
