{
  "name": "@notopia-uit/api-document-nestjs-server",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "@nx/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./api": {
      "@nx/source": "./src/api",
      "types": "./dist/api/index.d.ts",
      "import": "./dist/api/index.js"
    },
    "./controller": {
      "@nx/source": "./src/controller",
      "types": "./dist/controller/index.d.ts",
      "import": "./dist/controller/index.js"
    },
    "./decorator": {
      "@nx/source": "./src/decorator",
      "types": "./dist/decorator/index.d.ts",
      "import": "./dist/decorator/index.js"
    },
    "./models": {
      "@nx/source": "./src/models",
      "types": "./dist/models/index.d.ts",
      "import": "./dist/models/index.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "types": "./dist/index.d.ts"
}
