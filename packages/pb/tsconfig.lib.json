{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@notopia-uit/tsconfig/nestjs.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
    "paths": {
      ".*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts"]
}
