name: Renovate

on:
  workflow_dispatch:
  schedule:
    - cron: "0 4 * * 3,0"
      timezone: Asia/Ho_Chi_Minh

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  renovate:
    name: Run Renovate
    runs-on: ubuntu-latest

    steps:
      - name: Checkout Repository
        uses: actions/checkout@v6

      - name: Get token
        id: get-bot-token
        uses: actions/create-github-app-token@v2
        with:
          private-key: ${{ secrets.NOTOPIA_BOT_PRIVATE_KEY }}
          app-id: ${{ vars.NOTOPIA_BOT_APP_ID }}
          owner: ${{ github.repository_owner }}
          repositories: ${{ github.repository }}

      - name: Run Self-hosted Renovate
        uses: renovatebot/github-action@v46.3.8
        with:
          renovate-version: full
          configurationFile: .renovaterc.json
        env:
          RENOVATE_TOKEN: ${{ steps.get-bot-token.outputs.token }}
          RENOVATE_REPOSITORIES: ${{ github.repository }}
